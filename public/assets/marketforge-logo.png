<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 680" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgGlowFull" cx="50%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#f8fafc" />
    </radialGradient>

    <!-- Metallic Rim Gradient -->
    <linearGradient id="metalRimFull" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="25%" stop-color="#1d4ed8" />
      <stop offset="50%" stop-color="#93c5fd" />
      <stop offset="75%" stop-color="#1e40af" />
      <stop offset="100%" stop-color="#60a5fa" />
    </linearGradient>

    <!-- M Metallic Face Gradient -->
    <linearGradient id="mGrad1Full" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e0f2fe" />
      <stop offset="30%" stop-color="#38bdf8" />
      <stop offset="70%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#1e3a8a" />
    </linearGradient>

    <linearGradient id="mGrad2Full" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#2563eb" />
    </linearGradient>

    <!-- Arrow Gradient -->
    <linearGradient id="arrowGradFull" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1d4ed8" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#bae6fd" />
    </linearGradient>

    <!-- Spark Glow -->
    <radialGradient id="sparkGlowFull" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="30%" stop-color="#ea580c" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>

    <!-- OS Pill Metallic -->
    <linearGradient id="osPillGradFull" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="50%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>

    <filter id="shadowGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0f172a" flood-opacity="0.15" />
    </filter>
  </defs>

  <rect width="1000" height="680" fill="url(#bgGlowFull)" rx="24" />

  <!-- TOP EMBLEM LOGO MARK -->
  <g transform="translate(500, 190)">
    <!-- Globe & Constellation Network -->
    <g opacity="0.3" stroke="#0284c7" stroke-width="1.5" fill="none">
      <circle cx="0" cy="-30" r="130" stroke-dasharray="6 6" />
      <ellipse cx="0" cy="-30" rx="130" ry="50" />
      <ellipse cx="0" cy="-30" rx="60" ry="130" />
      <line x1="-130" y1="-30" x2="130" y2="-30" />
      <circle cx="-70" cy="-60" r="5" fill="#0284c7" />
      <circle cx="70" cy="-60" r="5" fill="#0284c7" />
      <circle cx="0" cy="-110" r="6" fill="#2563eb" />
      <line x1="-70" y1="-60" x2="0" y2="-110" stroke="#0284c7" stroke-width="2" />
      <line x1="0" y1="-110" x2="70" y2="-60" stroke="#0284c7" stroke-width="2" />
    </g>

    <!-- Metallic 3D Letter 'M' -->
    <g transform="scale(1.1) translate(0, -20)">
      <!-- Left Stem -->
      <path d="M -130 110 L -130 -80 L -80 -120 L -30 10 L -70 110 Z" fill="url(#mGrad2Full)" />
      <path d="M -115 100 L -115 -70 L -80 -105 L -45 0 L -75 100 Z" fill="url(#mGrad1Full)" />

      <!-- Center V -->
      <path d="M -30 10 L 0 100 L 30 10 L 0 110 Z" fill="url(#mGrad2Full)" />

      <!-- Right Stem -->
      <path d="M 30 10 L 80 -120 L 130 -80 L 130 110 L 70 110 Z" fill="url(#mGrad2Full)" />
      <path d="M 45 0 L 80 -105 L 115 -70 L 115 100 L 75 100 Z" fill="url(#mGrad1Full)" />
    </g>

    <!-- Growth Arrow Swoosh -->
    <path d="M -110 90 C -60 70, 40 0, 160 -120 L 120 -120 L 190 -145 L 180 -75 L 150 -105 C 40 0, -60 70, -110 90 Z" fill="url(#arrowGradFull)" filter="url(#shadowGlow)" />

    <!-- Anvil & Blacksmith Hammer Impact -->
    <g transform="translate(0, 50)">
      <!-- Anvil -->
      <path d="M -50 40 L 50 40 L 40 10 L 60 0 L 60 -10 L -60 -10 L -60 0 L -40 10 Z" fill="#1e293b" stroke="#64748b" stroke-width="1.5" />
      <path d="M -55 -8 L 55 -8 L 50 0 L -50 0 Z" fill="#cbd5e1" />

      <!-- Hammer -->
      <g transform="translate(0, -30) rotate(-28)">
        <rect x="-6" y="-30" width="12" height="40" rx="3" fill="#78350f" />
        <rect x="-18" y="-44" width="36" height="20" rx="4" fill="#475569" stroke="#f8fafc" stroke-width="1.5" />
      </g>

      <!-- Impact Sparks -->
      <circle cx="0" cy="-12" r="28" fill="url(#sparkGlowFull)" />
      <line x1="0" y1="-12" x2="-35" y2="-45" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" />
      <line x1="0" y1="-12" x2="35" y2="-45" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" />
      <line x1="0" y1="-12" x2="-45" y2="-20" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" />
      <line x1="0" y1="-12" x2="45" y2="-20" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" />
    </g>
  </g>

  <!-- BRAND NAME TYPOGRAPHY -->
  <g transform="translate(500, 430)">
    <text text-anchor="middle" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-weight="900" font-size="78" letter-spacing="-1">
      <tspan fill="#0a0f29">Market</tspan><tspan fill="#1e3a8a">Forge</tspan>
    </text>

    <!-- OS Pill Box -->
    <g transform="translate(270, -65)">
      <rect x="0" y="0" width="125" height="68" rx="22" fill="url(#osPillGradFull)" stroke="#38bdf8" stroke-width="3" filter="url(#shadowGlow)" />
      <text x="62" y="48" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="38" fill="#ffffff" text-anchor="middle" letter-spacing="2">OS</text>
      <text x="116" y="22" font-family="sans-serif" font-weight="bold" font-size="14" fill="#93c5fd">TM</text>
    </g>
  </g>

  <!-- TAGLINE WITH ACCENT DIVIDERS -->
  <g transform="translate(500, 495)">
    <line x1="-380" y1="-6" x2="-220" y2="-6" stroke="#94a3b8" stroke-width="1.5" />
    <text x="0" y="0" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="18" fill="#1e293b" letter-spacing="6" text-anchor="middle">
      A TRUE BUSINESS TRANSFORMATION
    </text>
    <line x1="220" y1="-6" x2="380" y2="-6" stroke="#94a3b8" stroke-width="1.5" />
  </g>

  <!-- 7 FEATURE CAPABILITY BADGES -->
  <g transform="translate(500, 580)">
    <!-- Pipeline Line -->
    <line x1="-360" y1="0" x2="360" y2="0" stroke="#cbd5e1" stroke-width="2" />

    <!-- Badge 1: CRM & Customers -->
    <g transform="translate(-360, 0)">
      <circle cx="0" cy="0" r="22" fill="#7e22ce" filter="url(#shadowGlow)" />
      <path d="M -8 6 C -8 0, 8 0, 8 6 M 0 -6 A 4 4 0 1 0 0 -14 A 4 4 0 1 0 0 -6" stroke="#ffffff" stroke-width="2" fill="none" />
      <text x="0" y="38" font-family="sans-serif" font-weight="700" font-size="10" fill="#334155" text-anchor="middle">CRM &amp; CUSTOMERS</text>
    </g>

    <!-- Badge 2: Sales & Marketing -->
    <g transform="translate(-240, 0)">
      <circle cx="0" cy="0" r="22" fill="#0284c7" filter="url(#shadowGlow)" />
      <path d="M -10 8 L -2 0 L 4 5 L 12 -7 M 6 -7 L 12 -7 L 12 -1" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <text x="0" y="38" font-family="sans-serif" font-weight="700" font-size="10" fill="#334155" text-anchor="middle">SALES &amp; MARKETING</text>
    </g>

    <!-- Badge 3: AI Insights -->
    <g transform="translate(-120, 0)">
      <circle cx="0" cy="0" r="22" fill="#0d9488" filter="url(#shadowGlow)" />
      <circle cx="0" cy="0" r="8" stroke="#ffffff" stroke-width="2" fill="none" />
      <path d="M 0 -12 L 0 -8 M 0 8 L 0 12 M -12 0 L -8 0 M 8 0 L 12 0" stroke="#ffffff" stroke-width="2" />
      <text x="0" y="38" font-family="sans-serif" font-weight="700" font-size="10" fill="#334155" text-anchor="middle">AI INSIGHTS</text>
    </g>

    <!-- Badge 4: Automation -->
    <g transform="translate(0, 0)">
      <circle cx="0" cy="0" r="22" fill="#ea580c" filter="url(#shadowGlow)" />
      <path d="M -7 -4 A 5 5 0 0 1 3 -4 L 7 0 A 5 5 0 0 1 -3 0 Z" stroke="#ffffff" stroke-width="2" fill="none" />
      <text x="0" y="38" font-family="sans-serif" font-weight="700" font-size="10" fill="#334155" text-anchor="middle">AUTOMATION</text>
    </g>

    <!-- Badge 5: Business Intelligence -->
    <g transform="translate(120, 0)">
      <circle cx="0" cy="0" r="22" fill="#c026d3" filter="url(#shadowGlow)" />
      <ellipse cx="0" cy="-6" rx="9" ry="4" stroke="#ffffff" stroke-width="1.8" fill="none" />
      <ellipse cx="0" cy="0" rx="9" ry="4" stroke="#ffffff" stroke-width="1.8" fill="none" />
      <ellipse cx="0" cy="6" rx="9" ry="4" stroke="#ffffff" stroke-width="1.8" fill="none" />
      <text x="0" y="38" font-family="sans-serif" font-weight="700" font-size="10" fill="#334155" text-anchor="middle">BUSINESS INTEL</text>
    </g>

    <!-- Badge 6: Security & Trust -->
    <g transform="translate(240, 0)">
      <circle cx="0" cy="0" r="22" fill="#1e40af" filter="url(#shadowGlow)" />
      <path d="M 0 -10 L 8 -6 L 8 1 C 8 7 0 11 0 11 C 0 11 -8 7 -8 1 L -8 -6 Z" stroke="#ffffff" stroke-width="2" fill="none" />
      <text x="0" y="38" font-family="sans-serif" font-weight="700" font-size="10" fill="#334155" text-anchor="middle">SECURITY &amp; TRUST</text>
    </g>

    <!-- Badge 7: Global Growth -->
    <g transform="translate(360, 0)">
      <circle cx="0" cy="0" r="22" fill="#15803d" filter="url(#shadowGlow)" />
      <circle cx="0" cy="0" r="10" stroke="#ffffff" stroke-width="2" fill="none" />
      <ellipse cx="0" cy="0" rx="4" ry="10" stroke="#ffffff" stroke-width="1.5" fill="none" />
      <line x1="-10" y1="0" x2="10" y2="0" stroke="#ffffff" stroke-width="1.5" />
      <text x="0" y="38" font-family="sans-serif" font-weight="700" font-size="10" fill="#334155" text-anchor="middle">GLOBAL GROWTH</text>
    </g>
  </g>
</svg>

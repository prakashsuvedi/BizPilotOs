{
  "name": "applet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "echo 'No lint'",
    "version:bump": "node scripts/bump-version.js",
    "fix-encoding": "node scripts/fix-encoding.js",
    "prebuild": "node scripts/fix-encoding.js",
    "build": "node scripts/fix-encoding.js && node scripts/bump-version.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "prepare": "husky || true",
    "deploy": "wrangler pages deploy dist",
    "deploy:pages": "wrangler pages deploy dist",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/compression": "^1.8.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "motion": "^12.42.2",
    "nodemailer": "^9.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "vite": "^5.0.0"
  }
}
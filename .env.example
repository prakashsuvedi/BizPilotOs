# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Override / Connection Controls
# Set to "true" to force production Firebase connectivity
FIREBASE_CONFIGURED=
# Your Firebase Project ID (both server and client side config)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=

# Optional Client-side override variables (prefixed with VITE_)
VITE_API_URL=https://marketforge-api-vpgj.onrender.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# SendGrid Direct Automation
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=user@example.com

# Modular Email Driver Configuration (resend, sendgrid, smtp, simulator, gmail)
EMAIL_PROVIDER=

# Email Mode ("sandbox" to prevent outbound, "live" to relay)
EMAIL_MODE=sandbox

# Secure SMTP Relay Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=user@example.com

# LinkedIn Publish Integration
LINKEDIN_MEMBER_TOKEN=
LINKEDIN_MEMBER_URN=

# Meta (Facebook/Instagram) Integration
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# cPanel Domain Automation Configuration
CPANEL_HOST=scamspike.com
CPANEL_PORT=2083
CPANEL_USER=scamspik
CPANEL_API_TOKEN=
CPANEL_ROOT_DOMAIN=scamspike.com

# Payment Gateways & Secure Webhook Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KHALTI_SECRET_KEY=
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBmUz3q1GE0rm3s
FONEPAY_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
